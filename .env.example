# PrédiMaint — copier vers .env (ne jamais committer de secrets réels)

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Atlas (recommandé) ou MongoDB local. Ne jamais coller un mot de passe réel ici.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/maintenance_db?retryWrites=true&w=majority
# Pour MongoDB local, commenter/supprimer MONGODB_URI puis utiliser :
# MONGO_URI=mongodb://127.0.0.1:27017/predimaint

JWT_SECRET=remplacer-par-une-cle-longue-aleatoire
JWT_EXPIRES_IN=8h

# SMTP utilisé pour envoyer les codes de vérification des inscriptions
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_ADMIN_EMAIL=

CORS_ORIGIN=http://localhost:5173

MQTT_BROKER_URL=mqtt://127.0.0.1:1883
MQTT_URL=mqtt://127.0.0.1:1883
CLIENT_URL=http://localhost:5173
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=predimaint-backend

OFFLINE_TIMEOUT_MS=120000
MEASUREMENT_RETENTION_DAYS=90
ALERT_REOPEN_COOLDOWN_MS=300000

# Mot de passe uniquement pour le script de seed de développement
SEED_PASSWORD=12345678
SEED_ON_START=false

# Bootstrap du premier administrateur (désactiver en production une fois créé)
ADMIN_BOOTSTRAP_ENABLED=true

SIMULATION_ENABLED=true
SIMULATION_INTERVAL_MS=4000
